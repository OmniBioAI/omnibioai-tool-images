# OmniBioAI — dupradar
# Purpose: Build the OmniBioAI container image for dupradar.
# Author: Manish Kumar <manish@omnibioai.org>
# Base image
FROM mambaorg/micromamba:1.5.8
# Tool installation
RUN micromamba install -y -n base -c bioconda -c conda-forge     bioconductor-dupradar && micromamba clean --all --yes
