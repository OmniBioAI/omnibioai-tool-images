# OmniBioAI — mol_gnn
# Purpose: Build the OmniBioAI container image for mol_gnn.
# Author: Manish Kumar <manish@omnibioai.org>
# Base image
FROM --platform=linux/arm64 nvidia/cuda:12.2.2-cudnn8-runtime-ubuntu22.04
# Runtime environment
ENV DEBIAN_FRONTEND=noninteractive
# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip git && \
    rm -rf /var/lib/apt/lists/*
# Python dependencies
RUN pip3 install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu
RUN pip3 install --no-cache-dir torch-geometric rdkit-pypi numpy pandas dgl dgllife
WORKDIR /data
# Entrypoint and default command
CMD ["python3", "-c", "import torch_geometric; print('Mol GNN ready')"]
# ── OmniBioAI tool runtime ─────────────────────────────────────────────────
RUN pip3 install boto3 azure-storage-blob azure-identity --no-cache-dir
COPY omnibioai-tool-runtime/tools /app/tools
COPY omnibioai-tool-runtime/omni_tool_runtime /app/omni_tool_runtime
COPY omnibioai-tool-runtime/pyproject.toml /app/pyproject.toml
WORKDIR /app
RUN pip3 install . --no-cache-dir
CMD ["python3", "-m", "tools.generic_sif_runner.run"]
