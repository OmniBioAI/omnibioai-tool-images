# OmniBioAI — cellcharter2
# Purpose: Build the OmniBioAI container image for cellcharter2.
# Author: Manish Kumar <manish@omnibioai.org>
# Base image
FROM mambaorg/micromamba:latest
# Tool installation
RUN micromamba install -y -n base -c bioconda -c conda-forge cellcharter \
    && micromamba clean --all --yes
