# OmniBioAI — seqkit_v3
# Purpose: Build the OmniBioAI container image for seqkit_v3.
# Author: Manish Kumar <manish@omnibioai.org>
# Base image
FROM mambaorg/micromamba:1.5.8
# Tool installation
RUN micromamba install -y -n base -c bioconda -c conda-forge     seqkit && micromamba clean --all --yes
