# OmniBioAI — cellsnp_lite
# Purpose: Build the OmniBioAI container image for cellsnp_lite.
# Author: Manish Kumar <manish@omnibioai.org>
# Base image
FROM mambaorg/micromamba:1.5.8
# Tool installation
RUN micromamba install -y -n base -c bioconda -c conda-forge     cellsnp-lite && micromamba clean --all --yes
