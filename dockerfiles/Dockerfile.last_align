# OmniBioAI — last_align
# Purpose: Build the OmniBioAI container image for last_align.
# Author: Manish Kumar <manish@omnibioai.org>
# Base image
FROM mambaorg/micromamba:1.5.8
# Tool installation
RUN micromamba install -y -n base -c bioconda -c conda-forge     last && micromamba clean --all --yes
