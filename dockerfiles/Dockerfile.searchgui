# OmniBioAI — searchgui
# Purpose: Build the OmniBioAI container image for searchgui.
# Author: Manish Kumar <manish@omnibioai.org>
# Base image
FROM mambaorg/micromamba:1.5.8
# Tool installation
RUN micromamba install -y -n base -c bioconda -c conda-forge     searchgui && micromamba clean --all --yes
