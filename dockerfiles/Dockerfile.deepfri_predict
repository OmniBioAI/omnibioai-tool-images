# syntax=docker/dockerfile:1
# OmniBioAI — deepfri_predict
# Purpose: Build the OmniBioAI container image for deepfri_predict.
# Author: Manish Kumar <manish@omnibioai.org>
# ARM64 image for deepfri_predict
FROM --platform=linux/arm64 python:3.11-slim-bookworm

LABEL maintainer="OmniBioAI <team@omnibioai.io>"
LABEL tool="deepfri_predict"
LABEL platform="linux/arm64"

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential && rm -rf /var/lib/apt/lists/*
# Pre-install CPU torch to prevent multi-GB CUDA wheel downloads
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir deepfri || pip install --no-cache-dir numpy pandas scipy
# ── OmniBioAI tool runtime ─────────────────────────────────────────────────
RUN pip install boto3 azure-storage-blob azure-identity --no-cache-dir
COPY omnibioai-tool-runtime/tools /app/tools
COPY omnibioai-tool-runtime/omni_tool_runtime /app/omni_tool_runtime
COPY omnibioai-tool-runtime/pyproject.toml /app/pyproject.toml
WORKDIR /app
RUN pip install . --no-cache-dir
# Entrypoint and default command
CMD ["python", "-m", "tools.generic_sif_runner.run"]
