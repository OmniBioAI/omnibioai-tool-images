# OmniBioAI — scopen_extra
# Purpose: Build the OmniBioAI container image for scopen_extra.
# Author: Manish Kumar <manish@omnibioai.org>
# Base image
FROM mambaorg/micromamba:1.5.8
# Tool installation
RUN micromamba install -y -n base -c bioconda -c conda-forge     scopen && micromamba clean --all --yes
