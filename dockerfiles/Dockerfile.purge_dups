# OmniBioAI — purge_dups
# Purpose: Build the OmniBioAI container image for purge_dups.
# Author: Manish Kumar <manish@omnibioai.org>
# Base image
FROM mambaorg/micromamba:latest
# Tool installation
RUN micromamba install -y -n base -c bioconda -c conda-forge purge_dups \
    && micromamba clean --all --yes
