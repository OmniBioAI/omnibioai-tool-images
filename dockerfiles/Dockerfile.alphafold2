# OmniBioAI — alphafold2
# Purpose: Build the OmniBioAI container image for alphafold2.
# Author: Manish Kumar <manish@omnibioai.org>
# Base image
FROM ubuntu:24.04
# System dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    wget \
    git \
    && pip3 install --break-system-packages \
    torch \
    biopython \
    numpy \
    scipy \
    absl-py \
    ml-collections \
    colabfold[alphafold-minus-jax]
# ── generic_sif_runner (handles S3/Azure download + results upload) ──
RUN pip install --break-system-packages boto3 azure-storage-blob azure-identity --no-cache-dir

COPY omnibioai-tool-runtime/tools /app/tools
COPY omnibioai-tool-runtime/omni_tool_runtime /app/omni_tool_runtime
COPY omnibioai-tool-runtime/pyproject.toml /app/pyproject.toml
WORKDIR /app
# Python dependencies
RUN pip install --break-system-packages -e . --no-cache-dir

# Entrypoint and default command
CMD ["python", "-m", "tools.generic_sif_runner.run"]
