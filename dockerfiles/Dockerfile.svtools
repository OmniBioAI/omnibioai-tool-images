# OmniBioAI — svtools
# Purpose: Build the OmniBioAI container image for svtools.
# Author: Manish Kumar <manish@omnibioai.org>
# Base image
FROM mambaorg/micromamba:latest
# Tool installation
RUN micromamba install -y -n base -c bioconda -c conda-forge svtools \
    && micromamba clean --all --yes
