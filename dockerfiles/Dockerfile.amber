# syntax=docker/dockerfile:1
# OmniBioAI — amber
# Purpose: Build the OmniBioAI container image for amber with an ARM64 unavailability placeholder.
# Author: Manish Kumar <manish@omnibioai.org>
# ARM64 image for amber
FROM --platform=linux/arm64 python:3.11-slim-bookworm

LABEL maintainer="OmniBioAI <team@omnibioai.io>"
LABEL tool="amber"
LABEL platform="linux/arm64"

# ambertools not available in conda ARM64 channels
RUN printf '#!/bin/sh\necho "amber is not available for ARM64 (ambertools not available in conda ARM64 channels)" >&2\nexit 1\n'     > /usr/local/bin/amber && chmod +x /usr/local/bin/amber
# ── OmniBioAI tool runtime ─────────────────────────────────────────────────
RUN pip install boto3 azure-storage-blob azure-identity --no-cache-dir
COPY omnibioai-tool-runtime/tools /app/tools
COPY omnibioai-tool-runtime/omni_tool_runtime /app/omni_tool_runtime
COPY omnibioai-tool-runtime/pyproject.toml /app/pyproject.toml
WORKDIR /app
RUN pip install . --no-cache-dir
# Entrypoint and default command
CMD ["python", "-m", "tools.generic_sif_runner.run"]
