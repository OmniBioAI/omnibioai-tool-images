# OmniBioAI — nanopolish
# Purpose: Build the OmniBioAI container image for nanopolish.
# Author: Manish Kumar <manish@omnibioai.org>
# Base image
FROM mambaorg/micromamba:latest
# Tool installation
RUN micromamba install -y -n base -c bioconda -c conda-forge nanopolish \
    && micromamba clean --all --yes
