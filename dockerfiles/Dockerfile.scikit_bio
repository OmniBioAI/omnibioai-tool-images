# OmniBioAI — scikit_bio
# Purpose: Build the OmniBioAI container image for scikit_bio.
# Author: Manish Kumar <manish@omnibioai.org>
# Base image
FROM mambaorg/micromamba:latest
# Tool installation
RUN micromamba install -y -n base -c bioconda -c conda-forge scikit-bio \
    && micromamba clean --all --yes
