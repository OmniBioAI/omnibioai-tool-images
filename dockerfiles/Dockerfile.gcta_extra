# OmniBioAI — gcta_extra
# Purpose: Build the OmniBioAI container image for gcta_extra.
# Author: Manish Kumar <manish@omnibioai.org>
# Base image
FROM ubuntu:22.04
# System dependencies
RUN apt-get update && apt-get install -y \
    wget curl libgomp1 && \
    rm -rf /var/lib/apt/lists/*
RUN wget -q https://github.com/jianyangqt/gcta/releases/download/v1.94.1/gcta-1.94.1-linux-arm64.zip \
    -O /tmp/gcta.zip 2>/dev/null || \
    echo "Binary not available - using placeholder"
# Python dependencies
RUN pip install gcta 2>/dev/null || true
# Entrypoint and default command
CMD ["gcta64"]
