# OmniBioAI — stitchr
# Purpose: Build the OmniBioAI container image for stitchr.
# Author: Manish Kumar <manish@omnibioai.org>
# Base image
FROM mambaorg/micromamba:latest
# Tool installation
RUN micromamba install -y -n base -c bioconda -c conda-forge stitchr \
    && micromamba clean --all --yes
