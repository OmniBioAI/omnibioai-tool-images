# OmniBioAI — genomescope2
# Purpose: Build the OmniBioAI container image for genomescope2.
# Author: Manish Kumar <manish@omnibioai.org>
# Base image
FROM mambaorg/micromamba:1.5.8
# Tool installation
RUN micromamba install -y -n base -c bioconda -c conda-forge     genomescope2 && micromamba clean --all --yes
