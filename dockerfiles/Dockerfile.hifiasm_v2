# OmniBioAI — hifiasm_v2
# Purpose: Build the OmniBioAI container image for hifiasm_v2.
# Author: Manish Kumar <manish@omnibioai.org>
# Base image
FROM mambaorg/micromamba:1.5.8
# Tool installation
RUN micromamba install -y -n base -c bioconda -c conda-forge     hifiasm && micromamba clean --all --yes
