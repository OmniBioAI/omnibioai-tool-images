# OmniBioAI — alevin_fry
# Purpose: Build the OmniBioAI container image for alevin_fry.
# Author: Manish Kumar <manish@omnibioai.org>
# Base image
FROM mambaorg/micromamba:1.5.8
# Architecture-specific configuration
RUN case "$(uname -m)" in \
      x86_64) package_build=hd612981_0 ;; \
      aarch64) package_build=h6789a04_0 ;; \
      *) echo "unsupported architecture: $(uname -m)" >&2; exit 1 ;; \
    esac \
    && micromamba install -y -n base -c bioconda -c conda-forge "alevin-fry=0.18.3=${package_build}" \
    && micromamba clean --all --yes
