# OmniBioAI — phylobayes
# Purpose: Build the OmniBioAI container image for phylobayes.
# Author: Manish Kumar <manish@omnibioai.org>
# Base image
FROM mambaorg/micromamba:latest
# Tool installation
RUN micromamba install -y -n base -c bioconda -c conda-forge phylobayes \
    && micromamba clean --all --yes
