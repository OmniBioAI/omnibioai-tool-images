# OmniBioAI — vardict
# Purpose: Build the OmniBioAI container image for vardict.
# Author: Manish Kumar <manish@omnibioai.org>
# Base image
FROM mambaorg/micromamba:1.5.8
# Tool installation
RUN micromamba install -y -n base -c bioconda -c conda-forge     vardict-java && micromamba clean --all --yes
