# OmniBioAI — fastx_extra
# Purpose: Build the OmniBioAI container image for fastx_extra.
# Author: Manish Kumar <manish@omnibioai.org>
# Base image
FROM mambaorg/micromamba:1.5.8
# Tool installation
RUN micromamba install -y -n base -c bioconda -c conda-forge     fastx_toolkit && micromamba clean --all --yes
