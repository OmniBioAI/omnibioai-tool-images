# OmniBioAI — starfish
# Purpose: Build the OmniBioAI container image for starfish.
# Author: Manish Kumar <manish@omnibioai.org>
# Base image
FROM mambaorg/micromamba:latest
# Tool installation
RUN micromamba install -y -n base -c bioconda -c conda-forge starfish \
    && micromamba clean --all --yes
