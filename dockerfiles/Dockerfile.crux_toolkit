# OmniBioAI — crux_toolkit
# Purpose: Build the OmniBioAI container image for crux_toolkit.
# Author: Manish Kumar <manish@omnibioai.org>
# Base image
FROM mambaorg/micromamba:1.5.8
# Tool installation
RUN micromamba install -y -n base -c bioconda -c conda-forge     crux-toolkit && micromamba clean --all --yes
