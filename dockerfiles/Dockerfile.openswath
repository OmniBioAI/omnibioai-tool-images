# OmniBioAI — openswath
# Purpose: Build the OmniBioAI container image for openswath.
# Author: Manish Kumar <manish@omnibioai.org>
# Base image
FROM mambaorg/micromamba:latest
# Tool installation
RUN micromamba install -y -n base -c bioconda -c conda-forge openswath \
    && micromamba clean --all --yes
