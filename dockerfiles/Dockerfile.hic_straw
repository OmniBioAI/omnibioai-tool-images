# OmniBioAI — hic_straw
# Purpose: Build the OmniBioAI container image for hic_straw.
# Author: Manish Kumar <manish@omnibioai.org>
# Base image
FROM mambaorg/micromamba:1.5.8
# Tool installation
RUN micromamba install -y -n base -c bioconda -c conda-forge     hic-straw && micromamba clean --all --yes
