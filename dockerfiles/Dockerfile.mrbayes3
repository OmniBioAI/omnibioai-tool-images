# OmniBioAI — mrbayes3
# Purpose: Build the OmniBioAI container image for mrbayes3.
# Author: Manish Kumar <manish@omnibioai.org>
# Base image
FROM mambaorg/micromamba:latest
# Tool installation
RUN micromamba install -y -n base -c bioconda -c conda-forge mrbayes \
    && micromamba clean --all --yes
