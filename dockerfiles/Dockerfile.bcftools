# OmniBioAI — BCFtools
# Purpose: Build the OmniBioAI container image for BCFtools.
# Author: Manish Kumar <manish@omnibioai.org>
# Base image
FROM python:3.11-slim-bookworm

# System dependencies
RUN apt-get update && apt-get install -y bcftools file && rm -rf /var/lib/apt/lists/*

# Runtime dependencies
RUN pip install boto3 azure-storage-blob azure-identity google-cloud-storage --no-cache-dir

COPY omnibioai-tool-runtime/tools /app/tools
COPY omnibioai-tool-runtime/omni_tool_runtime /app/omni_tool_runtime
COPY omnibioai-tool-runtime/pyproject.toml /app/pyproject.toml
WORKDIR /app
RUN pip install -e . --no-cache-dir

# Entrypoint and default command
CMD ["python", "-m", "tools.generic_sif_runner.run"]
