# OmniBioAI — abricate
# Purpose: Build the OmniBioAI container image for abricate.
# Author: Manish Kumar <manish@omnibioai.org>
# Base image
FROM mambaorg/micromamba:1.5.8
# Tool installation
RUN micromamba install -y -n base -c bioconda -c conda-forge     abricate=1.4.0=h05cac1d_0 && micromamba clean --all --yes
