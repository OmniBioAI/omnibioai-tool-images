# OmniBioAI — cryosparc_tools
# Purpose: Build the OmniBioAI container image for cryosparc_tools.
# Author: Manish Kumar <manish@omnibioai.org>
# Base image
FROM mambaorg/micromamba:latest
# Tool installation
RUN micromamba install -y -n base -c bioconda -c conda-forge cryosparc-tools \
    && micromamba clean --all --yes
