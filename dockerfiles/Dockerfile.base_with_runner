# syntax=docker/dockerfile:1
# OmniBioAI — base_with_runner
# Purpose: Build the OmniBioAI container image for base_with_runner.
# Author: Manish Kumar <manish@omnibioai.org>
# ARM64 base image with OmniBioAI tool runner
FROM --platform=linux/arm64 ubuntu:24.04

LABEL maintainer="OmniBioAI <team@omnibioai.io>"
LABEL tool="base_with_runner"
LABEL platform="linux/arm64"

# Runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip && \
    rm -rf /var/lib/apt/lists/* && \
    pip3 install boto3 azure-storage-blob azure-identity --break-system-packages
# ── OmniBioAI tool runtime ─────────────────────────────────────────────────
COPY omnibioai-tool-runtime/tools /app/tools
COPY omnibioai-tool-runtime/omni_tool_runtime /app/omni_tool_runtime
COPY omnibioai-tool-runtime/pyproject.toml /app/pyproject.toml
WORKDIR /app
RUN pip3 install . --break-system-packages
# Entrypoint and default command
CMD ["python3", "-m", "tools.generic_sif_runner.run"]
