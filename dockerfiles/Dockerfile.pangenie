# OmniBioAI — pangenie
# Purpose: Build the OmniBioAI container image for pangenie.
# Author: Manish Kumar <manish@omnibioai.org>
# Base image
FROM mambaorg/micromamba:latest
# Tool installation
RUN micromamba install -y -n base -c bioconda -c conda-forge pangenie \
    && micromamba clean --all --yes
