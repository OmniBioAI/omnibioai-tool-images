# OmniBioAI — monkeybread
# Purpose: Build the OmniBioAI container image for monkeybread.
# Author: Manish Kumar <manish@omnibioai.org>
# Base image
FROM mambaorg/micromamba:latest
# Tool installation
RUN micromamba install -y -n base -c bioconda -c conda-forge monkeybread \
    && micromamba clean --all --yes
