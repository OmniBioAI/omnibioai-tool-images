# OmniBioAI — battenberg
# Purpose: Build the OmniBioAI container image for battenberg.
# Author: Manish Kumar <manish@omnibioai.org>
# Base image
FROM mambaorg/micromamba:latest
# Tool installation
RUN micromamba install -y -n base -c bioconda -c conda-forge battenberg \
    && micromamba clean --all --yes
