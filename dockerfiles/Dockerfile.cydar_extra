# OmniBioAI — cydar_extra
# Purpose: Build the OmniBioAI container image for cydar_extra.
# Author: Manish Kumar <manish@omnibioai.org>
# Base image
FROM mambaorg/micromamba:1.5.8
# Tool installation
RUN micromamba install -y -n base -c bioconda -c conda-forge     bioconductor-cydar && micromamba clean --all --yes
