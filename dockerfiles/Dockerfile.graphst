# OmniBioAI — graphst
# Purpose: Build the OmniBioAI container image for graphst.
# Author: Manish Kumar <manish@omnibioai.org>
# Base image
FROM mambaorg/micromamba:latest
# Tool installation
RUN micromamba install -y -n base -c bioconda -c conda-forge graphst \
    && micromamba clean --all --yes
