# OmniBioAI — cooltools
# Purpose: Build the OmniBioAI container image for cooltools.
# Author: Manish Kumar <manish@omnibioai.org>
# Base image
FROM ubuntu:22.04
# Runtime environment
ENV DEBIAN_FRONTEND=noninteractive
# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-dev build-essential && \
    rm -rf /var/lib/apt/lists/*
# Python dependencies
RUN pip3 install --no-cache-dir cooltools cooler pairtools
WORKDIR /data
# Entrypoint and default command
CMD ["cooltools", "--version"]
# ── OmniBioAI tool runtime ─────────────────────────────────────────────────
RUN pip3 install boto3 azure-storage-blob azure-identity --no-cache-dir
COPY omnibioai-tool-runtime/tools /app/tools
COPY omnibioai-tool-runtime/omni_tool_runtime /app/omni_tool_runtime
COPY omnibioai-tool-runtime/pyproject.toml /app/pyproject.toml
WORKDIR /app
RUN pip3 install . --no-cache-dir
CMD ["python3", "-m", "tools.generic_sif_runner.run"]
