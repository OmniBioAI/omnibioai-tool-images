# OmniBioAI — dinosaur
# Purpose: Build the OmniBioAI container image for dinosaur.
# Author: Manish Kumar <manish@omnibioai.org>
# Base image
FROM mambaorg/micromamba:latest
# Tool installation
RUN micromamba install -y -n base -c bioconda -c conda-forge dinosaur \
    && micromamba clean --all --yes
