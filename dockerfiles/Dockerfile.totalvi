# syntax=docker/dockerfile:1
# OmniBioAI — totalvi
# Purpose: Build the OmniBioAI container image for totalvi.
# Author: Manish Kumar <manish@omnibioai.org>
# ARM64 image for totalvi
FROM --platform=linux/arm64 continuumio/miniconda3:latest

LABEL maintainer="OmniBioAI <team@omnibioai.io>"
LABEL tool="totalvi"
LABEL platform="linux/arm64"

# totalvi (part of scvi-tools) requires PyTorch C++ extensions that don't build on ARM64 via pip;
# install heavy deps via conda then scvi-tools itself --no-deps to skip the wheel.
RUN conda install -y -c bioconda -c conda-forge python=3.11 scvi-tools scanpy anndata numpy pandas scipy \
    && conda clean -afy
# Python dependencies
RUN pip install --no-cache-dir scvi-tools --no-deps
# ── OmniBioAI tool runtime ─────────────────────────────────────────────────
RUN pip install boto3 azure-storage-blob azure-identity --no-cache-dir
COPY omnibioai-tool-runtime/tools /app/tools
COPY omnibioai-tool-runtime/omni_tool_runtime /app/omni_tool_runtime
COPY omnibioai-tool-runtime/pyproject.toml /app/pyproject.toml
WORKDIR /app
RUN pip install . --no-cache-dir
# Entrypoint and default command
CMD ["python", "-m", "tools.generic_sif_runner.run"]
