# OmniBioAI — agat_extra
# Purpose: Build the OmniBioAI container image for agat_extra.
# Author: Manish Kumar <manish@omnibioai.org>
# Base image
FROM mambaorg/micromamba:1.5.8
# Tool installation
RUN micromamba install -y -n base -c bioconda -c conda-forge     agat=1.7.0=pl5321hdfd78af_0 && micromamba clean --all --yes
