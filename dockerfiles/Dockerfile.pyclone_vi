# OmniBioAI — pyclone_vi
# Purpose: Build the OmniBioAI container image for pyclone_vi.
# Author: Manish Kumar <manish@omnibioai.org>
# Base image
FROM mambaorg/micromamba:latest
# Tool installation
RUN micromamba install -y -n base -c bioconda -c conda-forge pyclone-vi \
    && micromamba clean --all --yes
