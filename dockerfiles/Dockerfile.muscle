# OmniBioAI — muscle
# Purpose: Build the OmniBioAI container image for muscle.
# Author: Manish Kumar <manish@omnibioai.org>
# Base image
FROM python:3.11-slim-bookworm AS muscle-builder

ARG MUSCLE_SOURCE_URL=https://deb.debian.org/debian/pool/main/m/muscle/muscle_5.1.0.orig.tar.gz
ARG MUSCLE_SOURCE_SHA256=2bba8b06e3ccabf6465fa26f459763b2029d7e7b9596881063e3aaba60d9e87d

# System dependencies
RUN apt-get update && apt-get install -y ca-certificates curl g++ make && rm -rf /var/lib/apt/lists/*
RUN set -eux; \
    curl -fsSL "$MUSCLE_SOURCE_URL" -o /tmp/muscle.tar.gz; \
    echo "$MUSCLE_SOURCE_SHA256  /tmp/muscle.tar.gz" | sha256sum -c -; \
    mkdir /tmp/muscle; \
    tar -xzf /tmp/muscle.tar.gz -C /tmp/muscle --strip-components=1; \
    grep -Fq 'defined(__x86_64__) || defined(_M_X64) || defined(__arm64__)' /tmp/muscle/src/myutils.h; \
    sed -i 's/defined(__x86_64__) || defined(_M_X64) || defined(__arm64__)/defined(__x86_64__) || defined(_M_X64) || defined(__arm64__) || defined(__aarch64__)/' /tmp/muscle/src/myutils.h; \
    grep -Fq 'defined(__arm64__) || defined(__aarch64__)' /tmp/muscle/src/myutils.h; \
    make -C /tmp/muscle/src -j"$(nproc)"

FROM python:3.11-slim-bookworm

RUN apt-get update && apt-get install -y file libgomp1 libstdc++6 && rm -rf /var/lib/apt/lists/*
COPY --from=muscle-builder /tmp/muscle/src/Linux/muscle /usr/local/bin/muscle
RUN set -eu; \
    muscle_version="$(muscle -version)"; \
    printf '%s\n' "$muscle_version"; \
    printf '%s\n' "$muscle_version" | grep -Eq '^muscle 5\.2\.linux64 '

# Runtime dependencies
RUN pip install boto3 azure-storage-blob azure-identity --no-cache-dir

COPY omnibioai-tool-runtime/tools /app/tools
COPY omnibioai-tool-runtime/omni_tool_runtime /app/omni_tool_runtime
COPY omnibioai-tool-runtime/pyproject.toml /app/pyproject.toml
WORKDIR /app
RUN pip install -e . --no-cache-dir

# Entrypoint and default command
CMD ["python", "-m", "tools.generic_sif_runner.run"]
