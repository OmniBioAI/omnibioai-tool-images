# OmniBioAI — spectronaut_cli
# Purpose: Build the OmniBioAI container image for spectronaut_cli.
# Author: Manish Kumar <manish@omnibioai.org>
# Base image
FROM mambaorg/micromamba:latest
# Tool installation
RUN micromamba install -y -n base -c bioconda -c conda-forge spectronaut \
    && micromamba clean --all --yes
