# OmniBioAI — ms2rescore
# Purpose: Build the OmniBioAI container image for ms2rescore.
# Author: Manish Kumar <manish@omnibioai.org>
# Base image
FROM mambaorg/micromamba:1.5.8
# Tool installation
RUN micromamba install -y -n base -c bioconda -c conda-forge     ms2rescore && micromamba clean --all --yes
