# OmniBioAI — gem3_mapper
# Purpose: Build the OmniBioAI container image for gem3_mapper.
# Author: Manish Kumar <manish@omnibioai.org>
# Base image
FROM mambaorg/micromamba:1.5.8
# Tool installation
RUN micromamba install -y -n base -c bioconda -c conda-forge     gem3-mapper && micromamba clean --all --yes
