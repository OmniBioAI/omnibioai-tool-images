# OmniBioAI — chimerax_cli
# Purpose: Build the OmniBioAI container image for chimerax_cli.
# Author: Manish Kumar <manish@omnibioai.org>
# Base image
FROM mambaorg/micromamba:latest
# Tool installation
RUN micromamba install -y -n base -c bioconda -c conda-forge chimerax \
    && micromamba clean --all --yes
