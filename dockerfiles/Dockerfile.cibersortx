# OmniBioAI — cibersortx
# Purpose: Build the OmniBioAI container image for cibersortx.
# Author: Manish Kumar <manish@omnibioai.org>
# Base image
FROM ubuntu:22.04
# Runtime environment
ENV DEBIAN_FRONTEND=noninteractive
# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    r-base wget ca-certificates python3 python3-pip && \
    rm -rf /var/lib/apt/lists/*
# R/Bioconductor dependencies
RUN Rscript -e "install.packages(c('e1071','parallel','preprocessCore'), repos='https://cloud.r-project.org')"
WORKDIR /data
# Entrypoint and default command
CMD ["Rscript", "--version"]
# ── OmniBioAI tool runtime ─────────────────────────────────────────────────
RUN pip3 install boto3 azure-storage-blob azure-identity --no-cache-dir
COPY omnibioai-tool-runtime/tools /app/tools
COPY omnibioai-tool-runtime/omni_tool_runtime /app/omni_tool_runtime
COPY omnibioai-tool-runtime/pyproject.toml /app/pyproject.toml
WORKDIR /app
RUN pip3 install . --no-cache-dir
CMD ["python3", "-m", "tools.generic_sif_runner.run"]
