# OmniBioAI — igv_reports
# Purpose: Build the OmniBioAI container image for igv_reports.
# Author: Manish Kumar <manish@omnibioai.org>
# Base image
FROM mambaorg/micromamba:1.5.8
# Tool installation
RUN micromamba install -y -n base -c bioconda -c conda-forge     igv-reports && micromamba clean --all --yes
